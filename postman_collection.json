{
  "info": {
    "name": "E-Commerce Backend REST API",
    "description": "Collection covering all 10 required APIs (Users & Products) plus success and error test cases.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "apiKey", "value": "my-secret-api-key-123" }
  ],
  "item": [
    {
      "name": "Users",
      "item": [
        {
          "name": "1. GET All Users",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/users", "host": ["{{baseUrl}}"], "path": ["api", "users"] }
          }
        },
        {
          "name": "2. GET Single User (Success)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/users/1", "host": ["{{baseUrl}}"], "path": ["api", "users", "1"] }
          }
        },
        {
          "name": "2b. GET Single User (Not Found - 404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/users/999", "host": ["{{baseUrl}}"], "path": ["api", "users", "999"] }
          }
        },
        {
          "name": "3. POST Add User (Success)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Bilal Hassan\",\n  \"email\": \"bilal.hassan@example.com\",\n  \"age\": 30\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/users?apiKey={{apiKey}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users"],
              "query": [{ "key": "apiKey", "value": "{{apiKey}}" }]
            }
          }
        },
        {
          "name": "3b. POST Add User (Validation Error - 400)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"B\",\n  \"email\": \"not-an-email\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/users?apiKey={{apiKey}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users"],
              "query": [{ "key": "apiKey", "value": "{{apiKey}}" }]
            }
          }
        },
        {
          "name": "3c. POST Add User (No API Key - 401)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Bilal Hassan\",\n  \"email\": \"bilal.hassan@example.com\",\n  \"age\": 30\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/users", "host": ["{{baseUrl}}"], "path": ["api", "users"] }
          }
        },
        {
          "name": "4. PUT Update User (Success)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ali Khan Updated\",\n  \"email\": \"ali.khan@example.com\",\n  \"age\": 29\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/users/1?apiKey={{apiKey}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "1"],
              "query": [{ "key": "apiKey", "value": "{{apiKey}}" }]
            }
          }
        },
        {
          "name": "4b. PUT Update User (Invalid API Key - 401)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ali Khan Updated\",\n  \"email\": \"ali.khan@example.com\",\n  \"age\": 29\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/users/1?apiKey=wrong-key",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "1"],
              "query": [{ "key": "apiKey", "value": "wrong-key" }]
            }
          }
        },
        {
          "name": "5. DELETE User (Success)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/users/2?apiKey={{apiKey}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "2"],
              "query": [{ "key": "apiKey", "value": "{{apiKey}}" }]
            }
          }
        },
        {
          "name": "5b. DELETE User (Not Found - 404)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/users/999?apiKey={{apiKey}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "999"],
              "query": [{ "key": "apiKey", "value": "{{apiKey}}" }]
            }
          }
        }
      ]
    },
    {
